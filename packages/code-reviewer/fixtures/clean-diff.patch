+++ b/src/main/resources/db/migration/V6__add_visited_resorts_user_index.sql
@@ -0,0 +1,4 @@
+-- Owner-scoped visited lookups drive the resort list, and visited_resorts only carries a
+-- UNIQUE (user_id, resort_id) constraint today. Forward-only, no data change, and portable:
+-- CREATE INDEX parses identically on H2 in PostgreSQL mode and on Neon Postgres.
+CREATE INDEX idx_visited_resorts_user_id ON visited_resorts (user_id);
