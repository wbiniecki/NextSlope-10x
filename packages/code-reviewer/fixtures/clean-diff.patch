+package com.nextslope.resort;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.stream.Collectors;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import lombok.RequiredArgsConstructor;
+
+/**
+ * Read-only summary statistics over the shared resort catalog, for the admin list header.
+ *
+ * <p>The catalog is shared reference data rather than user-owned data, so there is no principal to
+ * scope by and no ownership predicate to enforce — unlike the visited-resort and preference-profile
+ * paths, which resolve their owner through {@code CurrentUserService.requireUserId}.
+ */
+@Service
+@RequiredArgsConstructor
+public class ResortCatalogStatsService {
+
+	private final ResortRepository resortRepository;
+
+	/** Active resorts per country, in the catalog's own country ordering. */
+	@Transactional(readOnly = true)
+	public Map<String, Long> activeResortCountByCountry() {
+		return resortRepository.findByActiveTrueOrderByCountryAscNameAsc().stream()
+				.collect(Collectors.groupingBy(
+						Resort::getCountry,
+						LinkedHashMap::new,
+						Collectors.counting()));
+	}
+}
diff --git a/src/main/resources/db/migration/V6__add_visited_resorts_user_index.sql b/src/main/resources/db/migration/V6__add_visited_resorts_user_index.sql
